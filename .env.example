# FinInferenceGym environment variables — template.
# Copy to .env (gitignored) and fill in values.

# Database — Neon Postgres connection string.
# Get from https://console.neon.tech after creating a project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# LLM API keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Data vendors.
NORGATE_USERNAME=
NORGATE_PASSWORD=
IBKR_ACCOUNT=

# Optional: development overrides
# LOG_LEVEL=DEBUG
# CACHE_DIR=./data_cache
