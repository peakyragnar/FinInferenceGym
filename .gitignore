# Secrets — never commit
.env
.env.local
*.pem
*.key

# Trajectory store and data cache — too large for git, but keep the
# directory present after clone via .gitkeep.
trajectory_store/*
!trajectory_store/.gitkeep
data_cache/*
!data_cache/.gitkeep

# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# uv
.venv/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Detect-secrets baseline (kept separately if used)
.secrets.baseline
